    "error.contextTooLong" : {
      "comment" : "Panel, after a failure: the request is too long for the model",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This draft is too long for the model. Shorten it and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este borrador es demasiado largo para el modelo. Acórtalo y vuelve a intentarlo."
          }
        }
      }
    },
    "error.dropped" : {
      "comment" : "Panel notice under the kept text: the connection dropped after part of the result arrived",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection dropped mid-answer. Try again for the full prompt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión se cortó a mitad. Reintenta para obtener el prompt completo."
          }
        }
      }
    },
    "error.droppedEarly" : {
      "comment" : "Panel, after a failure: the connection dropped before any text arrived",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection dropped before any answer. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión se cortó antes de recibir respuesta. Vuelve a intentarlo."
          }
        }
      }
    },
    "error.emptyOutput" : {
      "comment" : "Panel, after a failure: the model answered with nothing",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The model sent back an empty answer. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo ha devuelto una respuesta vacía. Vuelve a intentarlo."
          }
        }
      }
    },
    "error.generic" : {
      "comment" : "Panel, after a failure: any failure without a more specific line",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo ha fallado. Vuelve a intentarlo."
          }
        }
      }
    },
    "error.invalidKey" : {
      "comment" : "Panel, after a failure: the provider rejected the API key; %@ is the provider",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rejected your API key. Check it in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha rechazado tu clave de API. Revísala en Ajustes."
          }
        }
      }
    },
    "error.invalidRequest" : {
      "comment" : "Panel, after a failure: the provider refused the request; %@ is the provider",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ couldn't accept this request. Edit the draft and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no ha aceptado la petición. Edita el borrador y vuelve a intentarlo."
          }
        }
      }
    },
    "error.malformed" : {
      "comment" : "Panel, after a failure: the provider's answer could not be read; %@ is the provider",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sent an answer that couldn't be read. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha enviado una respuesta que no se ha podido leer. Vuelve a intentarlo."
          }
        }
      }
    },
    "error.modelUnavailable" : {
      "comment" : "Panel, after a failure: the key cannot use the chosen model; %@ is the model",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your key can't use %@. Choose another model in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave no puede usar %@. Elige otro modelo en Ajustes."
          }
        }
      }
    },
    "error.noCredit" : {
      "comment" : "Panel, after a failure: the provider account is out of credit; %@ is the provider",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %@ account is out of credit. Add credit and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta de %@ no tiene saldo. Añade saldo y vuelve a intentarlo."
          }
        }
      }
    },
    "error.noKey" : {
      "comment" : "Panel, after a failure: no API key is stored; %@ is the provider",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no API key for %@. Add one in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta la clave de API de %@. Añádela en Ajustes."
          }
        }
      }
    },
    "error.offline" : {
      "comment" : "Panel, after a failure: there is no network connection",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're offline. Check your connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay conexión. Comprueba tu red y vuelve a intentarlo."
          }
        }
      }
    },
    "error.overloaded" : {
      "comment" : "Panel, after a failure: the provider is overloaded; %@ is the provider",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is overloaded right now. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está saturado ahora mismo. Reintenta en un momento."
          }
        }
      }
    },
    "error.permissionDenied" : {
      "comment" : "Panel, after a failure: the key lacks permission; %@ is the provider",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %@ key isn't allowed to do this. Check its permissions, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave de %@ no tiene permiso para esto. Revisa sus permisos y vuelve a intentarlo."
          }
        }
      }
    },
    "error.rateLimited" : {
      "comment" : "Panel, after a failure: rate limited with a wait; %d is the seconds left, counting down",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rate limit reached. Try again in %d s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has alcanzado el límite de peticiones. Reintenta en %d s."
          }
        }
      }
    },
    "error.rateLimitedNow" : {
      "comment" : "Panel, after a failure: rate limited with no wait, or the wait is over",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rate limit reached. Try again now, or pick another engine with ⌘K."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has alcanzado el límite de peticiones. Reintenta ahora o elige otro motor con ⌘K."
          }
        }
      }
