# Afino release pipeline configuration. The Xcode project, the scheme and the bundle identifier
# keep the name the app had before 1.0 (PromptImprover). The bundle identifier and the feed URL
# must not change once a release is out: installed copies find their updates through them.
PROJECT_FILE="PromptImprover.xcodeproj"
SCHEME_NAME="PromptImprover"
CONFIGURATION="Release"
APP_NAME="Afino"

# Release invariants.
EXPECTED_BUNDLE_IDENTIFIER="com.jnjambrin0.PromptImprover"
SPARKLE_FEED_URL="https://jnjambrin0.github.io/Afino/updates/stable/appcast.xml"

# Update hosting output.
UPDATES_DIR="./updates/stable"
GITHUB_REPOSITORY="jnjambrin0/Afino"
GITHUB_PAGES_BRANCH="gh-pages"
GITHUB_PAGES_PATH="updates/stable"

# Sparkle tooling location.
# Example:
# SPARKLE_BIN="$HOME/Library/Developer/Xcode/DerivedData/.../SourcePackages/artifacts/sparkle/Sparkle/bin"
# Leave empty to auto-resolve from:
# 1) ./build/release/DerivedData/SourcePackages/artifacts/sparkle/Sparkle/bin (the release build itself)
# 2) ./build/DerivedData/SourcePackages/artifacts/sparkle/Sparkle/bin (scripts/build.sh)
SPARKLE_BIN=""

# Signing/notarization.
# The Developer ID identity as `security find-identity -v -p codesigning` prints it, and the
# notarytool keychain profile (create it once with `xcrun notarytool store-credentials`).
# Every release is Developer ID signed and notarized: an ad-hoc build under the release bundle
# identifier would make the Keychain prompt for each stored API key, so there is no local,
# unsigned release path.
DEVELOPER_ID_APPLICATION="Developer ID Application: Jaime Navas (DZ97PSDX9S)"
DEVELOPMENT_TEAM_ID="DZ97PSDX9S"
NOTARY_PROFILE="AC_NOTARY"

# Optional explicit xcodebuild path.
XCODEBUILD_BIN="/Applications/Xcode.app/Contents/Developer/usr/bin/xcodebuild"

# Where the release build keeps its DerivedData (inside the checkout, so the Sparkle tools used
# to sign the feed are the ones this build resolved).
RELEASE_DERIVED_DATA="./build/release/DerivedData"
