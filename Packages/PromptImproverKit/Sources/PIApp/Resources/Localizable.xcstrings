{
  "sourceLanguage" : "en",
  "strings" : {
    "alert.ok" : {
      "comment" : "Button of the alert shown when Afino could not move itself to Applications",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceptar"
          }
        }
      }
    },
    "install.move.confirm" : {
      "comment" : "Alert at launch when Afino runs outside Applications: button that moves it there",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move to Applications"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover a Aplicaciones"
          }
        }
      }
    },
    "install.move.later" : {
      "comment" : "Alert at launch when Afino runs outside Applications: button that leaves it where it is",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not Now"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora no"
          }
        }
      }
    },
    "install.move.message" : {
      "comment" : "Alert at launch when Afino runs outside Applications: message",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afino can only update itself from the Applications folder. It will move there and open again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afino solo puede actualizarse desde la carpeta Aplicaciones. Se moverá allí y se volverá a abrir."
          }
        }
      }
    },
    "install.move.title" : {
      "comment" : "Alert at launch when Afino runs outside Applications: title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
