    "welcome.demo.result" : {
      "comment" : "Welcome, step 1 (intro): the improved prompt that streams into the illustrated panel; about 45 words, so it fits in four lines",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write a short, polite email to my landlord. The heater in my flat has not worked since Monday. Ask for a repair visit this week, offer two times I can be at home, and keep the tone friendly but firm. Under 120 words."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe un correo breve y educado a mi casero. La calefacción de mi piso no funciona desde el lunes. Pide que vengan a repararla esta semana, propón dos horas en las que puedo estar en casa y mantén un tono amable pero firme. Menos de 120 palabras."
          }
        }
      }
    },
    "welcome.demo.thinking" : {
      "comment" : "Welcome, step 1 (intro): status in the illustrated panel while the caret breathes, worded as the panel words it",
